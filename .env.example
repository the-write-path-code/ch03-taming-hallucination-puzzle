# Embedded Qdrant is the default: persisted locally with no Docker required.
QDRANT_LOCAL_PATH=./.qdrant_local

# Optional: leave both settings blank to use embedded local Qdrant.
# For a Docker-hosted local server, set QDRANT_URL=http://localhost:6333.
# For Qdrant Cloud, set your cluster URL and API key. No code changes are required.
QDRANT_URL=
QDRANT_API_KEY=

# Qdrant stage 3.4 collection & reranking configuration
QDRANT_COLLECTION_PREFIX=ch03_retrieval
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_RERANK_CANDIDATES=20


# LLM provider key, used for HyDE query expansion, generation steps, and
# the "openai" dense embedding provider below.
OPENAI_API_KEY=

# Dense embedding provider used by naive_baseline/ and later stages.
# One of: ollama, openai, local-bge-m3.
DENSE_PROVIDER=ollama

# Ollama: local by default (no key needed). For Ollama Cloud, set
# OLLAMA_BASE_URL to your cloud endpoint and set OLLAMA_API_KEY.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_EMBED_MODEL=bge-m3

# OpenAI-compatible embeddings, used when DENSE_PROVIDER=openai.
# Leave OPENAI_BASE_URL empty to use the official OpenAI API.
OPENAI_BASE_URL=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Local BGE-M3, used when DENSE_PROVIDER=local-bge-m3.
# Requires: uv sync --extra local-bge-m3
LOCAL_BGE_M3_MODEL_NAME=BAAI/bge-m3

# Default k for hit@k evaluation across all retrieval stages.
RETRIEVAL_TOP_K=3

# HyDE query expansion (used only when a stage is run with --use-hyde).
# Off by default; requires OPENAI_API_KEY to activate.
HYDE_MODEL=gpt-4o-mini

# Hybrid retrieval configuration for Section 3.3.
# bm25 works in the base environment. bge_m3_sparse requires local-bge-m3.
HYBRID_SPARSE_METHOD=bm25

# One of: rrf, relative_score.
HYBRID_FUSION_METHOD=rrf

# RRF rank constant. Higher values reduce the influence of top positions.
RRF_K=60

# Used only by relative_score fusion. Values are normalized by their sum.
HYBRID_DENSE_WEIGHT=0.5
HYBRID_SPARSE_WEIGHT=0.5

