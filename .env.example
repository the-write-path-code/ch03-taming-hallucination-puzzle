# Qdrant connection. Defaults to a local Docker instance.
# To use Qdrant Cloud instead, replace QDRANT_URL with your cluster URL
# and set QDRANT_API_KEY. No code changes are required either way.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM provider key, used for HyDE query expansion, generation steps, and
# the "openai" dense embedding provider below.
OPENAI_API_KEY=

# Dense embedding provider used by naive_baseline/ and later stages.
# One of: ollama, openai, local-bge-m3.
DENSE_PROVIDER=ollama

# Ollama: local by default (no key needed). For Ollama Cloud, set
# OLLAMA_BASE_URL to your cloud endpoint and set OLLAMA_API_KEY.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_EMBED_MODEL=bge-m3

# OpenAI-compatible embeddings, used when DENSE_PROVIDER=openai.
# Leave OPENAI_BASE_URL empty to use the official OpenAI API.
OPENAI_BASE_URL=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Local BGE-M3, used when DENSE_PROVIDER=local-bge-m3.
# Requires: uv sync --extra local-bge-m3
LOCAL_BGE_M3_MODEL_NAME=BAAI/bge-m3

# Default k for hit@k evaluation across all retrieval stages.
RETRIEVAL_TOP_K=3
